{
  // Global settings
  "collaboration_panel": {
    "button": false
  },
  "vim_mode": false,
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "remove_trailing_whitespace_on_save": true,
  "base_keymap": "VSCode",

  "inline_code_actions": false,
  "disable_ai": true,

  "agent": {
    "enabled": true,
    "button": true,
    "model_parameters": [],
  },

  // UI

  "title_bar": {
    "show_onboarding_banner": false,
  },

  "tab_bar": {
    "show": false,
  },

  "toolbar": {
    "quick_actions": false,
  },

  "git_panel": {
    "dock": "left",
    "default_width": 450,
  },

  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "entry_spacing": "comfortable",
    "sticky_scroll": false,
    "starts_open": false,
  },

  "file_finder": {
    "modal_max_width": "medium",
  },

  "minimap": null,
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "indent_guides": {
    "enabled": false,
  },

  // Font
  "tab_size": 2,
  "ui_font_size": 18,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",

  "buffer_font_size": 20,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_line_height": "comfortable",
  "current_line_highlight": "line",

  // Theme
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Kanagawa",
  },

  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Symbols Icon Theme",
  },

  "theme_overrides": {
    "Kanagawa": {
      "border": "#1e1f29",
      "border.variant": "#1e1f29",
      "title_bar.background": "#1e1f29",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },

  // Terminal
  "terminal": {
    "env": {},
    "font_size": 16,
    "keep_selection_on_copy": true,
    "font_family": "JetBrainsMono Nerd Font Mono",

    "shell": {
      "program": "/home/ferreira-gn/.nix-profile/bin/fish",
    },
  },

  // Languages
  "languages": {
    "JavaScript": { "format_on_save": "on" },
    "TypeScript": { "format_on_save": "on" },
    "JSON": { "format_on_save": "on" },
    "Markdown": { "format_on_save": "on" },
    "Go": {
      "format_on_save": "on",
    },
  },

  "lsp": {
    "typescript-language-server": {
      "settings": {
        "codeActionOnSave": {
          "source.fixAll.eslint": true,
          "source.organizeImports": true,
        },
      },
    },

    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
}
